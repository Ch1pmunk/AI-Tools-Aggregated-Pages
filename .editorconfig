# ===========================================================================
# .editorconfig —— 把「这个项目里文件该长什么样」写成机器能读的规则
# ---------------------------------------------------------------------------
# 存在的理由只有一个：**有些坑写在文档里没人会记得，写在这里编辑器会替你守住。**
# 最典型的就是下面的 *.cmd —— 那不是风格偏好，是改错了就跑不起来的硬约束。
# 见 docs/changelog.md「LF 换行让 cmd.exe 的解析器丢失同步」那一条。
# ===========================================================================

root = true

[*]
charset = utf-8                  # 这台机器整机 UTF-8，中文直接写，不做任何转码
end_of_line = lf
insert_final_newline = true
trim_trailing_whitespace = true
indent_style = space

[*.{js,json,css,html}]
indent_size = 2

# ——— 批处理必须是 CRLF，这条没有商量余地 ———
# LF 换行 + 多字节字符会让 cmd.exe 的解析器**丢失同步**：它按 CRLF 认行，
# 认不出来就从中间截断，把注释的后半截当成命令去执行。
# 症状极具误导性（报错里出现的乱码片段和真正的原因没关系，看起来像编码问题），
# 真踩过一次。所以这条不写在文档里靠人记，写在这里靠编辑器守。
[*.{cmd,bat}]
end_of_line = crlf

# Markdown 里的行尾空格有时是**有意义的**（换行），不自动删
[*.md]
trim_trailing_whitespace = false
