@echo off
REM ===========================================================================
REM  双击本文件即可启动两个服务（静态页 :3000 + 数据服务 :3001）。
REM
REM  **关掉这个窗口 = 两个服务一起停。** 这件事由 Windows 保证，不是本脚本做的：
REM  两个服务是本窗口控制台的子进程，控制台窗口一关，系统会把挂在这个控制台上的
REM  进程全部收掉。Ctrl+C 同样有效。
REM
REM  所以正常情况下不需要手动去杀进程。真出现端口占着不放时，按 Readme.md
REM  第十三节的步骤来：netstat 找到 PID，再 taskkill /F /PID <那个 PID>。
REM  **绝对不要用 `taskkill /F /IM node.exe`** —— 那会杀掉机器上所有 node 进程，
REM  包括别人的。
REM
REM ---------------------------------------------------------------------------
REM  真正的启动逻辑在 scripts\start.js（端口只在那里推导一次）。
REM  本文件只是一层「双击得动」的壳，不重复任何配置 —— 见 scripts/README.md。
REM ===========================================================================

title AI工具聚合页 —— 关闭本窗口即停止两个服务
cd /d "%~dp0"

node scripts\start.js

REM 只有 node 自己失败退出（退出码 >= 1）才停下来，好让双击的人看清报错。
REM Ctrl+C 是正常退出（start.js 那里退 0），不会在这儿卡住。
REM pause 不加提示语：cmd 自己会打一句本地化的「请按任意键继续」。
if errorlevel 1 pause
